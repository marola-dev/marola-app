# Copy to .env for local development. Never commit the real .env.
# Every var below is optional — marola's defaults (Provider.Local everywhere, a local Ollama
# server at localhost:11434) need none of this set. Set only the ones for whichever Azure
# integration you're opting into (docs/ARCHITECTURE.md §5/§6) — never all of them at once "just in
# case." In deployed environments these Azure endpoints/keys are still needed, but auth itself goes
# through azure-identity's DefaultAzureCredential (managed identity), not a key in this file.

# --- Telegram bot (Phase 1, not built yet — see docs/ARCHITECTURE.md §11) ---
MAROLA_TELEGRAM_BOT_TOKEN=

# --- LLM: local (default) vs. Azure Foundry ---
MAROLA_LLM_PROVIDER=local
MAROLA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
MAROLA_LOCAL_LLM_MODEL=llama3.2:1b
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini
FOUNDRY_API_VERSION=2026-01-01-preview

# --- Distance refinement: haversine (default) vs. Azure Maps ---
AZURE_MAPS_SUBSCRIPTION_KEY=

# --- Sighting reports: local JSON-lines (default) vs. Cosmos DB ---
MAROLA_SIGHTING_STORE_PROVIDER=local
MAROLA_LOCAL_SIGHTING_STORE_PATH=./data/sightings.jsonl
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=marola
COSMOS_DB_CONTAINER=sightings

# --- Photo analysis: local multimodal Ollama (default) vs. Azure AI Vision ---
MAROLA_VISION_PROVIDER=local
MAROLA_LOCAL_VISION_MODEL=llava
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Observability: off by default (Azure's own standard var name, no MAROLA_ prefix, so every
#     Azure Monitor SDK/agent picks it up automatically) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Beach search radius override (default: 15km) ---
MAROLA_BEACH_SEARCH_RADIUS_KM=15.0
