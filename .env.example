# Copy to .env for local overrides; never commit the real .env. direnv (.envrc) and Docker Compose
# load it. Every variable is optional. Uncomment a line to change it: the values shown are the
# defaults, except the origin and the tracking URI, which are examples. What each one does:
# docs/4-reference_config.md.

# --- Ollama: the LLM, vision and embedding models ---
# MAROLA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# MAROLA_LOCAL_LLM_MODEL=llama3.2
# MAROLA_LOCAL_EMBED_MODEL=llama3.2
# MAROLA_LOCAL_VISION_MODEL=llava

# --- The corpus and --ask ---
# The app's default; the just recipes use .tmp/knowledge (corpus-fetch's) unless this is set.
# MAROLA_KNOWLEDGE_DIR=./knowledge
# MAROLA_KNOWLEDGE_INDEX_PATH=./data/knowledge-index.json
# MAROLA_ASK_FALLBACK=general
# MAROLA_ASK_MIN_SCORE=0.0
# MAROLA_SEA_LORE=on

# --- Where to search, and which sources ---
# MAROLA_ORIGIN_LAT=-27.6733
# MAROLA_ORIGIN_LON=-48.4700
# MAROLA_BEACH_SEARCH_RADIUS_KM=15
# MAROLA_WATER_QUALITY_PROVIDER=auto
# MAROLA_FACILITIES=overpass
# Read only when the directory exists.
# MAROLA_BEACHES_DIR=./site/beaches
# MAROLA_LOCAL_SIGHTING_STORE_PATH=./data/sightings.jsonl

# --- MLflow ledger and traces (`just mlflow-up` serves http://127.0.0.1:5000) ---
# MAROLA_MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MAROLA_MLFLOW_EXPERIMENT=marola
# MAROLA_TRACES=off
# MAROLA_TRACE_CONTENT=0

# --- Telegram (Phase 1; read but unused until the bot exists). A secret: set it only in .env ---
# MAROLA_TELEGRAM_BOT_TOKEN=

# --- Context7 MCP (.mcp.json, opencode.json); without a key the free tier is rate-limited ---
CONTEXT7_API_KEY=
