# Copy to .env for local development. Never commit the real .env.
# In deployed environments these are NOT read from .env — the app
# authenticates via azure-identity's DefaultAzureCredential against a
# managed identity. This file is for local `sbt run` only, where you'll
# typically `az login` and let DefaultAzureCredential pick that up instead
# of setting most of these.

# --- Foundry / Azure OpenAI ---
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# --- Document Intelligence ---
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/

# --- Azure AI Search (RAG) ---
AI_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AI_SEARCH_INDEX=simples-nacional-docs

# --- Storage / DB ---
DATABASE_URL=jdbc:postgresql://localhost:5432/nforganizer
STORAGE_ACCOUNT_BLOB_ENDPOINT=https://<storage-account-name>.blob.core.windows.net

# --- Cost governor (Phase 0 hard-coded defaults live in code; override here for local testing) ---
COST_GOVERNOR_MAX_REQUESTS_PER_USER_PER_DAY=20
COST_GOVERNOR_MAX_COST_CENTS_PER_USER_PER_DAY=200
COST_GOVERNOR_MAX_COST_CENTS_ACCOUNT_PER_DAY=5000

# --- Azure Communication Services (WhatsApp) — Phase 3, not needed before ---
ACS_CONNECTION_STRING=
WHATSAPP_CHANNEL_ID=
